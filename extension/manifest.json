{
  "manifest_version": 3,
  "name": "Google Home Camera Grid",
  "version": "0.1.4",
  "description": "Choose, arrange, and recover camera feeds in Google Home for web.",
  "short_name": "Camera Grid",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://home.google.com/*"],
    "css": ["grid.css"],
    "js": ["grid.js"]
  }]
}
